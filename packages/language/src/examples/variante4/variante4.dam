game DamDamFastDark {
  board { size 8 }

  pieces {
    piece whiteShadow { color gray quantity 12 }
    piece blackShadow { color silver quantity 12 }
  }

  rules {
    movement {
      alternating whiteShadow and blackShadow
      direction diagonal
      canMoveBackward true
    }
    capture {
      mandatory true
      message "Yummyyyyyy !"
    }
  }

  objective {
    winByForfeit { allowed true }
    winByCapture { captureAll opponent }
  }

  ui {
    theme {
      lightSquares: "darkgray"
      darkSquares: "black"
      highlight: "crimson"
    }
  }

  settings {
    showLegalMoves: false
    darkMode: true
  }
}
