game DamDamRoyal {
  board { size 10 }

  pieces {
    piece white { color white quantity 10 }
    piece black { color black quantity 10 }
  }

  dice { faces 6 }

  rules {
    movement {
      alternating white and black
      direction any
      canMoveBackward true
    }
    capture {
      mandatory true
      message "NomNomNomNom"
    }
  }

  objective { 
    winByForfeit { allowed true} 
    winByCapture { captureAll opponent }
  }

  ui {
    theme {
      lightSquares: "gold"
      darkSquares: "indigo"
      highlight: "pink"
    }
  }

  settings { 
    showLegalMoves: false
    darkMode : true
  }
}
