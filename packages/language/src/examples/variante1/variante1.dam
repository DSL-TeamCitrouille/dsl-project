game DamDamClassic {
  board {
    size 8
  }

  pieces {
    piece white { color white quantity 12 }
    piece black { color black quantity 12 }
  }

  rules {
    movement {
      alternating white and black
      direction diagonal
      canMoveBackward false
    }
    capture {
      mandatory true
      message "Miam Miam Miam !"
    }
  }

  objective {
    winByCapture { captureAll opponent }
  }

  ui {
    theme {
      lightSquares: "beige"
      darkSquares: "brown"
      highlight: "sandybrown"
    }
  }

  settings {
    showLegalMoves: true
    darkMode : false
  }
}
